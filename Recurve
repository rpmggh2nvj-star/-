<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Recurve｜試験対策プランナー</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Zen+Antique&family=Zen+Kaku+Gothic+New:wght@400;500;700;900&family=JetBrains+Mono:wght@400;500;700&display=swap');

:root{
  --paper:#F1F4EF;
  --card:#FCFBF8;
  --ink:#2A2E28;
  --ink-soft:#6B7268;
  --line:#DCE0D6;

  --c-teiki:#C88A2E;
  --c-teiki-tint:#F4E3C4;
  --c-teiki-deep:#8A5A1E;

  --c-cbt:#35406B;
  --c-cbt-tint:#E4E7F0;
  --c-cbt-deep:#35406B;

  --c-kokushi:#164F46;
  --c-kokushi-tint:#DCEAE6;
  --c-kokushi-deep:#164F46;

  --red:#B14A3B;
  --red-tint:#F5DEDA;
  --green:#1F6F63;
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;}
body{
  background:var(--paper);
  color:var(--ink);
  font-family:'Zen Kaku Gothic New', sans-serif;
  -webkit-font-smoothing:antialiased;
  min-height:100vh;
}
@media (prefers-reduced-motion: reduce){
  *{ transition:none !important; animation:none !important; }
}
:focus-visible{ outline:2px solid var(--green); outline-offset:2px; }

.loading-screen{
  display:flex; align-items:center; justify-content:center;
  height:60vh; color:var(--ink-soft); font-size:14px;
}

.app-shell{ max-width:880px; margin:0 auto; padding:20px 16px 80px; }

/* header */
.app-header{ margin-bottom:20px; }
.header-main{
  display:flex; justify-content:space-between; align-items:flex-start;
  flex-wrap:wrap; gap:12px; margin-bottom:14px;
}
.brand{ display:flex; align-items:center; gap:12px; }
.brand-mark{
  display:flex; align-items:center; flex-shrink:0;
}
.time-sep{ color:var(--line); margin:0 4px; }
.task-understanding{ font-size:11px; color:var(--ink-soft); font-family:'JetBrains Mono',monospace; }
.studytime-bar{ position:relative; height:16px; background:var(--line); border-radius:8px; overflow:hidden; }
.studytime-fill{ height:100%; background:var(--green); border-radius:8px; transition:width 0.4s ease; }
.ghost-fill{ background:rgba(42,46,40,0.35); }
.ghost-caption{ font-size:12px; color:var(--ink-soft); margin-top:6px; }
.ghost-ahead{ color:var(--green); font-weight:700; }
.ghost-behind{ color:var(--red); font-weight:700; }
.pomodoro-box{ background:var(--card); border:1px solid var(--line); border-radius:10px; padding:16px; text-align:center; margin-bottom:16px; }
.pomodoro-phase-row{ display:flex; justify-content:center; align-items:center; gap:10px; margin-bottom:4px; }
.pomodoro-phase-badge{ font-size:11px; font-weight:700; padding:2px 10px; border-radius:999px; font-family:'JetBrains Mono',monospace; }
.phase-work{ background:var(--c-cbt-tint); color:var(--c-cbt-deep); }
.phase-short{ background:var(--c-teiki-tint); color:var(--c-teiki-deep); }
.phase-long{ background:var(--c-kokushi-tint); color:var(--c-kokushi-deep); }
.pomodoro-cycle{ font-size:12px; color:var(--ink-soft); font-family:'JetBrains Mono',monospace; }
.pomodoro-time{ font-family:'JetBrains Mono',monospace; font-size:42px; font-weight:700; margin:4px 0 12px; letter-spacing:0.02em; }
.pomodoro-controls{ display:flex; gap:8px; justify-content:center; }
.race-bars{ margin-top:4px; }
.race-row{ display:flex; align-items:center; gap:10px; margin-bottom:8px; }
.race-label{ width:180px; flex-shrink:0; font-size:12px; }
.race-row .studytime-bar{ flex:1; }
.race-value{ width:52px; text-align:right; font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--ink-soft); flex-shrink:0; }
.brand h1{
  font-family:'Zen Antique', serif; font-size:24px; margin:0 0 2px;
  letter-spacing:0.04em;
}
.subtitle{ margin:0; font-size:12px; color:var(--ink-soft); }
.header-meta{ text-align:right; font-size:12px; color:var(--ink-soft); }
.today-date{ font-family:'JetBrains Mono',monospace; font-size:13px; margin-bottom:4px; }
.streak{ font-size:13px; }
.streak-best{ color:var(--ink-soft); font-size:11px; }

.tabs{ display:flex; gap:4px; border-bottom:1px solid var(--line); }
.tab-btn{
  appearance:none; border:none; background:none; cursor:pointer;
  font-family:'Zen Kaku Gothic New', sans-serif; font-size:14px; font-weight:700;
  padding:10px 14px; color:var(--ink-soft); border-bottom:2px solid transparent;
  margin-bottom:-1px;
}
.tab-btn.active{ color:var(--c-kokushi); border-bottom-color:var(--c-kokushi); }

/* sections */
.section{ margin:22px 0; }
.section-title{
  font-family:'Zen Antique', serif; font-size:17px; margin:0 0 10px;
  display:flex; align-items:center; gap:8px; flex-wrap:wrap;
}
.tip-line{ font-size:12px; color:var(--ink-soft); margin:-4px 0 14px; line-height:1.6; }
.empty-hint{ font-size:13px; color:var(--ink-soft); background:var(--card); border:1px dashed var(--line); border-radius:8px; padding:14px; }
.plan-tip, .plan-note{ font-size:12px; color:var(--ink-soft); line-height:1.7; }

/* track chip pill */
.track-chip{
  display:inline-block; padding:2px 10px; border-radius:999px;
  font-size:11px; font-weight:700; font-family:'JetBrains Mono',monospace;
  white-space:nowrap;
}
.chip-teiki{ background:var(--c-teiki-tint); color:var(--c-teiki-deep); }
.chip-cbt{ background:var(--c-cbt-tint); color:var(--c-cbt-deep); }
.chip-kokushi{ background:var(--c-kokushi-tint); color:var(--c-kokushi-deep); }

/* today: track summary cards */
.track-cards{ display:flex; gap:12px; flex-wrap:wrap; }
.track-card{
  flex:1; min-width:190px; background:var(--card); border:1px solid var(--line);
  border-top:4px solid var(--ink-soft); border-radius:10px; padding:14px 16px;
}
.track-card.tc-teiki{ border-top-color:var(--c-teiki); }
.track-card.tc-cbt{ border-top-color:var(--c-cbt); }
.track-card.tc-kokushi{ border-top-color:var(--c-kokushi); }
.track-card-top{ display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; }
.alloc-pct{ font-size:11px; color:var(--ink-soft); font-family:'JetBrains Mono',monospace; }
.countdown{ font-family:'JetBrains Mono',monospace; font-size:34px; font-weight:700; line-height:1; }
.countdown-unit{ font-size:13px; font-weight:400; margin-left:2px; color:var(--ink-soft); }
.track-examdate{ font-size:12px; color:var(--ink-soft); margin:4px 0 8px; }
.track-gap{ font-size:12px; }

/* due list */
.due-count{ font-size:12px; background:var(--red); color:#fff; border-radius:999px; padding:1px 8px; font-family:'JetBrains Mono',monospace; }
.due-list{ display:flex; flex-direction:column; gap:8px; }
.due-item{
  display:flex; align-items:center; gap:8px; flex-wrap:wrap;
  background:var(--red-tint); border:1px solid var(--red); border-radius:8px; padding:10px 12px;
}
.due-name{ font-weight:700; flex:1; min-width:100px; }
.due-level{ font-size:12px; color:var(--ink-soft); font-family:'JetBrains Mono',monospace; }

/* buttons */
.btn-small, .btn-primary, .btn-outline, .btn-outline-danger{
  font-family:'Zen Kaku Gothic New', sans-serif; font-size:12px; font-weight:700;
  border-radius:7px; padding:7px 12px; cursor:pointer; border:1px solid var(--line);
}
.btn-small{ background:var(--card); color:var(--ink); }
.btn-small:hover{ border-color:var(--green); }
.btn-primary{ background:var(--green); color:#fff; border-color:var(--green); }
.btn-outline{ background:none; color:var(--ink-soft); }
.btn-outline-danger{ background:none; color:var(--red); border-color:var(--red); }
.icon-btn{
  border:none; background:none; cursor:pointer; color:var(--ink-soft); font-size:14px;
  padding:2px 6px;
}
.icon-btn:hover{ color:var(--red); }

/* task list */
.task-list{ display:flex; flex-direction:column; gap:6px; margin-bottom:10px; }
.task-item{
  display:flex; align-items:center; gap:10px; background:var(--card);
  border:1px solid var(--line); border-radius:8px; padding:9px 12px; flex-wrap:wrap;
}
.task-item.done{ opacity:0.5; text-decoration:line-through; }
.task-check input{ display:none; }
.checkmark{
  display:inline-block; width:16px; height:16px; border:1.5px solid var(--ink-soft);
  border-radius:4px; cursor:pointer; position:relative;
}
.task-check input:checked + .checkmark{ background:var(--green); border-color:var(--green); }
.task-check input:checked + .checkmark::after{
  content:''; position:absolute; left:4px; top:1px; width:4px; height:8px;
  border:solid #fff; border-width:0 2px 2px 0; transform:rotate(40deg);
}
.task-name{ font-weight:700; }
.task-activity{ font-size:12px; color:var(--ink-soft); }
.task-minutes{ margin-left:auto; font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--ink-soft); }
.manual-add{ display:flex; gap:8px; margin:10px 0; }
.text-input, .number-input, .date-input{
  font-family:'Zen Kaku Gothic New', sans-serif; font-size:13px; padding:7px 10px;
  border:1px solid var(--line); border-radius:7px; background:#fff; color:var(--ink);
}
.text-input{ flex:1; }

/* karute */
.track-header{ display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
.track-header-date{ font-size:12px; color:var(--ink-soft); font-family:'JetBrains Mono',monospace; margin-left:auto; }
.subject-grid{
  display:grid; grid-template-columns:repeat(auto-fill,minmax(230px,1fr));
  gap:12px; margin:12px 0;
}
.subject-card{
  background:var(--card); border:1px solid var(--line); border-radius:10px; padding:12px 14px;
}
.subject-card.is-due{ border-color:var(--red); background:var(--red-tint); }
.subject-card-top{ display:flex; justify-content:space-between; align-items:center; margin-bottom:4px; }
.subject-name{ font-weight:700; font-size:14px; }
.decay-svg{ width:100%; height:60px; display:block; margin:6px 0; }
.decay-mec{ stroke:var(--red); stroke-dasharray:3 3; stroke-width:1; }
.decay-next{ stroke:var(--ink-soft); stroke-dasharray:2 2; stroke-width:1; }
.decay-empty{ font-size:10px; fill:var(--ink-soft); }
.subject-meta{ display:flex; justify-content:space-between; font-size:11px; color:var(--ink-soft); margin-bottom:6px; }
.range-input{ width:100%; accent-color:var(--green); margin-bottom:8px; }
.btn-record{ width:100%; }
.add-subject-row{ display:flex; gap:8px; margin-top:6px; }

/* plan */
.alloc-bar{ display:flex; height:16px; border-radius:6px; overflow:hidden; border:1px solid var(--line); }
.alloc-seg{ height:100%; }
.bar-teiki{ background:var(--c-teiki); }
.bar-cbt{ background:var(--c-cbt); }
.bar-kokushi{ background:var(--c-kokushi); }
.alloc-legend{ display:flex; gap:16px; flex-wrap:wrap; margin:10px 0; font-size:12px; }
.legend-dot{ display:inline-block; width:10px; height:10px; border-radius:3px; margin-right:5px; vertical-align:middle; }
.weight-list{ display:flex; flex-direction:column; gap:8px; margin-top:10px; }
.weight-row{ display:flex; align-items:center; gap:10px; font-size:12px; }
.weight-name{ width:130px; flex-shrink:0; }
.weight-bar-track{ flex:1; background:var(--line); border-radius:5px; height:10px; overflow:hidden; }
.weight-bar-fill{ height:100%; }
.weight-pct{ width:36px; text-align:right; font-family:'JetBrains Mono',monospace; color:var(--ink-soft); }
.phase-list{ display:flex; flex-direction:column; gap:10px; margin-top:10px; }
.phase-card{ background:var(--card); border:1px solid var(--line); border-left:4px solid var(--c-kokushi); border-radius:8px; padding:12px 14px; }
.phase-label{ font-weight:700; margin-bottom:2px; }
.phase-dates{ font-size:12px; color:var(--ink-soft); font-family:'JetBrains Mono',monospace; margin-bottom:4px; }
.phase-focus{ font-size:13px; }

/* settings */
.settings-row{ display:flex; align-items:center; gap:14px; flex-wrap:wrap; margin-bottom:10px; }
.settings-row label{ font-size:12px; color:var(--ink-soft); display:flex; align-items:center; gap:6px; }

/* modal */
.modal-overlay{
  position:fixed; inset:0; background:rgba(42,46,40,0.45);
  display:flex; align-items:center; justify-content:center; padding:16px; z-index:50;
}
.modal-box{
  background:#fff; border-radius:12px; padding:22px; width:100%; max-width:340px;
}
.modal-box h3{ margin:0 0 2px; font-family:'Zen Antique', serif; }
.modal-sub{ font-size:12px; color:var(--ink-soft); margin:0 0 16px; }
.modal-label{ font-size:12px; color:var(--ink-soft); display:block; margin-bottom:4px; }
.modal-value{ font-family:'JetBrains Mono',monospace; text-align:right; font-size:13px; margin-bottom:14px; }
.modal-actions{ display:flex; justify-content:flex-end; gap:8px; margin-top:8px; }

/* toast */
#toast-container{ position:fixed; bottom:18px; left:50%; transform:translateX(-50%); z-index:100; display:flex; flex-direction:column; gap:6px; align-items:center; }
.toast{
  background:var(--ink); color:#fff; padding:8px 16px; border-radius:999px; font-size:12px;
  opacity:1; transition:opacity 0.3s;
}
.toast-out{ opacity:0; }

@media (max-width:560px){
  .header-main{ flex-direction:column; }
  .header-meta{ text-align:left; }
  .countdown{ font-size:28px; }
  .weight-name{ width:90px; }
}
</style>
