  ];
}

/* ---------- pomodoro timer ---------- */
const POMO_WORK = 25*60;
const POMO_SHORT = 5*60;
const POMO_LONG = 20*60;
let pomodoroTickHandle = null;

function phaseDuration(phase){
  if(phase==='work') return POMO_WORK;
  if(phase==='short_break') return POMO_SHORT;
  return POMO_LONG;
}
function phaseLabel(phase){
  if(phase==='work') return '作業';
  if(phase==='short_break') return '小休憩';
  return '長い休憩';
}
function fmtMMSS(totalSeconds){
  const s = Math.max(0, Math.round(totalSeconds));
  const m = Math.floor(s/60);
  const sec = s%60;
  return String(m).padStart(2,'0')+':'+String(sec).padStart(2,'0');
}
function playBeep(){
  try{
    const Ctx = window.AudioContext || window.webkitAudioContext;
    const ctx = new Ctx();
    const o = ctx.createOscillator();
    const g = ctx.createGain();
    o.connect(g); g.connect(ctx.destination);
    o.frequency.value = 880;
    g.gain.setValueAtTime(0.15, ctx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime+0.4);
    o.start();
    o.stop(ctx.currentTime+0.4);
  }catch(e){ /* audio unavailable, ignore */ }
}
function ensureFreshPomodoroDay(){
  const p = state.pomodoro;
  if(p.todayStartedAt && p.todayStartedAt.slice(0,10) !== todayStr()){
    state.pomodoro = { status:'idle', phase:'work', cycle:1, phaseEndAt:null, remainingWhenPaused:null, todayStartedAt:null };
  }
}
function completePomodoroPhase(atIso){
  const p = state.pomodoro;
  const endedAt = atIso || new Date().toISOString();
  if(p.phase==='work'){
    const startedAt = new Date(new Date(endedAt).getTime() - POMO_WORK*1000).toISOString();
    state.timerSessions.push({ date: endedAt.slice(0,10), startedAt, endedAt, minutes: POMO_WORK/60 });
    updateStreak();
    showToast('作業終了！お疲れ様です');
    p.phase = (p.cycle >= 4) ? 'long_break' : 'short_break';
  } else if(p.phase==='short_break'){
    p.cycle += 1;
    p.phase = 'work';
    showToast('休憩終了、再開しましょう');
  } else {
    p.cycle = 1;
    p.phase = 'work';
    showToast('長い休憩終了、次のセットです');
  }
  playBeep();
}
function pomodoroStartPause(){
  ensureFreshPomodoroDay();
  const p = state.pomodoro;
  if(p.status === 'running'){
    const remaining = Math.max(0, Math.round((new Date(p.phaseEndAt) - new Date())/1000));
    p.remainingWhenPaused = remaining;
    p.phaseEndAt = null;
    p.status = 'paused';
    stopPomodoroTicking();
  } else {
    const dur = (p.status==='paused' && p.remainingWhenPaused!=null) ? p.remainingWhenPaused : phaseDuration(p.phase);
    p.phaseEndAt = new Date(Date.now() + dur*1000).toISOString();
    p.remainingWhenPaused = null;
    p.status = 'running';
    if(!p.todayStartedAt) p.todayStartedAt = new Date().toISOString();
    ensurePomodoroTicking();
  }
  saveState();
}
function pomodoroReset(){
  const keepStart = state.pomodoro.todayStartedAt;
  state.pomodoro = { status:'idle', phase:'work', cycle:1, phaseEndAt:null, remainingWhenPaused:null, todayStartedAt: keepStart };
  stopPomodoroTicking();
  saveState();
}
function ensurePomodoroTicking(){
  if(pomodoroTickHandle) return;
  pomodoroTickHandle = setInterval(pomodoroTick, 1000);
}
function stopPomodoroTicking(){
  if(pomodoroTickHandle){ clearInterval(pomodoroTickHandle); pomodoroTickHandle = null; }
}
function pomodoroTick(){
  const p = state.pomodoro;
  if(p.status !== 'running' || !p.phaseEndAt){ stopPomodoroTicking(); return; }
  const remainingSec = (new Date(p.phaseEndAt) - new Date())/1000;
  if(remainingSec <= 0){
    completePomodoroPhase(p.phaseEndAt);
    p.phaseEndAt = new Date(Date.now() + phaseDuration(p.phase)*1000).toISOString();
    saveState();
    render();
  } else {
    updatePomodoroDisplay(remainingSec);
    updateRaceBarsDisplay();
  }
}
function catchUpPomodoro(){
  ensureFreshPomodoroDay();
  const p = state.pomodoro;
  if(p.status === 'running' && p.phaseEndAt && new Date(p.phaseEndAt) <= new Date()){
    completePomodoroPhase(p.phaseEndAt);
    p.phaseEndAt = new Date(Date.now() + phaseDuration(p.phase)*1000).toISOString();
    saveState();
  }
  if(p.status === 'running') ensurePomodoroTicking();
}
function updatePomodoroDisplay(remainingSec){
  const el = document.getElementById('pomodoro-remaining');
  if(el) el.textContent = fmtMMSS(remainingSec);
}
function updateRaceBarsDisplay(){
  const el = document.getElementById('race-bars-section');
  if(el && activeTab==='today') el.innerHTML = raceBarsInnerHtml();
}

/* ---------- study time & best-day ghost ---------- */
function dailyTimerTotals(){
  const totals = {};
  state.timerSessions.forEach(s=>{ totals[s.date] = (totals[s.date]||0) + s.minutes; });
  return totals;
}
function findBestDay(totals){
  let best = null, bestMin = -1;
  Object.keys(totals).forEach(d=>{
    if(d === todayStr()) return;
    if(totals[d] > bestMin){ bestMin = totals[d]; best = d; }
  });
  return best;
}
function dayFirstSessionStart(dateStr){
  const sessions = state.timerSessions.filter(s=>s.date===dateStr).sort((a,b)=> new Date(a.startedAt)-new Date(b.startedAt));
  return sessions.length ? sessions[0].startedAt : null;
}
function cumulativeAtElapsed(dateStr, elapsedMinutes){
  const start = dayFirstSessionStart(dateStr);
  if(!start) return 0;
  const cutoff = new Date(new Date(start).getTime() + elapsedMinutes*60000);
  return state.timerSessions
    .filter(s => s.date===dateStr && new Date(s.endedAt) <= cutoff)
    .reduce((a,s)=>a+s.minutes, 0);
}
function todayTimerTotal(){
  const d = todayStr();
  return state.timerSessions.filter(s=>s.date===d).reduce((a,s)=>a+s.minutes,0);
}
function todayElapsedMinutes(){
  if(!state.pomodoro.todayStartedAt) return 0;
  return Math.max(0, (Date.now() - new Date(state.pomodoro.todayStartedAt).getTime())/60000);
}

/* ---------- state mutations ---------- */
function recordSession(trackId, subjectId, understanding, minutes){
  const subj = state.tracks[trackId].subjects.find(s=>s.id===subjectId);
  if(!subj) return;
  const prevStage = subj.reviewStage || 0;
  let newStage = prevStage;
  if(understanding >= 70) newStage = Math.min(prevStage+1, INTERVALS.length-1);
  else if(understanding < 40) newStage = 0;
  subj.understanding = understanding;
  subj.reviewStage = newStage;
  subj.lastStudied = todayStr();
  state.studyLog.push({ date: todayStr(), trackId, subjectId, understanding, minutes: minutes||0, loggedAt: new Date().toISOString() });
  markCompletion(trackId, subjectId);
  updateStreak();
  saveState();
}
function markCompletion(trackId, subjectId){
  const d = todayStr();
  if(!state.completions[d]) state.completions[d] = [];
  const key = trackId+':'+subjectId;
  if(!state.completions[d].includes(key)) state.completions[d].push(key);
}
function unmarkCompletion(trackId, subjectId){
  const d = todayStr();
  const key = trackId+':'+subjectId;
  if(state.completions[d]) state.completions[d] = state.completions[d].filter(x=>x!==key);
  saveState();
}
function updateStreak(){
  const d = todayStr();
  if(state.streak.lastDate === d) return;
  if(state.streak.lastDate){
    const gap = daysBetween(state.streak.lastDate, d);
    if(gap === 1) state.streak.current += 1;
    else state.streak.current = 1;
  } else {
    state.streak.current = 1;
  }
  state.streak.lastDate = d;
  if(state.streak.current > state.streak.best) state.streak.best = state.streak.current;
}
function addSubject(trackId){
  const input = document.querySelector('[data-new-subject="'+trackId+'"]');
  const name = input && input.value.trim();
  if(!name) return;
  state.tracks[trackId].subjects.push({ id:uid(), name, understanding:20, lastStudied:null, reviewStage:0 });
  input.value = '';
  saveState();
}
function deleteSubject(trackId, subjectId){
  state.tracks[trackId].subjects = state.tracks[trackId].subjects.filter(s=>s.id!==subjectId);
  saveState();
}
function addManualTask(){
  const input = document.getElementById('manual-task-input');
  const text = input && input.value.trim();
  if(!text) return;
  const d = todayStr();
  if(!state.manualTasks[d]) state.manualTasks[d] = [];
