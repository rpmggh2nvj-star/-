function raceBarsInnerHtml(){
  const totals = dailyTimerTotals();
  const bestDay = findBestDay(totals);
  const todayTotal = todayTimerTotal();
  const elapsed = todayElapsedMinutes();

  if(!bestDay){
    const scale = Math.max(state.dailyMinutes,1);
    const pct = Math.min(100, Math.round(todayTotal/scale*100));
    return '<div class="race-row"><span class="race-label">🏃 今日のあなた</span>' +
      '<div class="studytime-bar"><div class="studytime-fill" style="width:'+pct+'%"></div></div>' +
      '<span class="race-value">'+todayTotal+'分</span></div>' +
      '<p class="ghost-caption">まだ自己ベストの記録がありません。タイマーで学習を記録すると、次回から自己ベストのゴーストと競争できます。</p>';
  }

  const bestTotal = totals[bestDay];
  const scale = Math.max(bestTotal, 1);
  const ghostAtElapsed = cumulativeAtElapsed(bestDay, elapsed);
  const ghostPct = Math.min(100, Math.round(ghostAtElapsed/scale*100));
  const todayPct = Math.min(100, Math.round(todayTotal/scale*100));
  const diff = todayTotal - ghostAtElapsed;
  const diffText = diff > 0 ? ('+'+Math.round(diff)+'分リード') : (diff < 0 ? (Math.round(Math.abs(diff))+'分ビハインド') : '同着');
  const diffClass = diff >= 0 ? 'ghost-ahead' : 'ghost-behind';
  const newRecord = todayTotal > bestTotal ? '<p class="ghost-caption ghost-ahead">🎉 自己ベスト更新中！</p>' : '';

  return '<div class="race-row"><span class="race-label">👻 自己ベスト（'+formatDate(bestDay)+'・計'+bestTotal+'分）</span>' +
    '<div class="studytime-bar"><div class="studytime-fill ghost-fill" style="width:'+ghostPct+'%"></div></div>' +
    '<span class="race-value">'+Math.round(ghostAtElapsed)+'分</span></div>' +
    '<div class="race-row"><span class="race-label">🏃 今日のあなた</span>' +
    '<div class="studytime-bar"><div class="studytime-fill" style="width:'+todayPct+'%"></div></div>' +
    '<span class="race-value">'+todayTotal+'分</span></div>' +
    (state.pomodoro.todayStartedAt ?
      '<p class="ghost-caption">開始から'+Math.round(elapsed)+'分経過時点の比較 ／ <span class="'+diffClass+'">'+diffText+'</span></p>'
      : '<p class="ghost-caption">タイマーを開始すると、自己ベストとのリアルタイム比較が始まります。</p>') +
    newRecord;
}
