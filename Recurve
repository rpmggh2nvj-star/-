      '<div class="subject-grid">'+cards+'</div>' +
      '<div class="add-subject-row"><input type="text" class="text-input" placeholder="科目名を追加" data-new-subject="'+k+'">' +
      '<button class="btn-small" data-action="add-subject" data-track="'+k+'">＋ 科目を追加</button></div>' +
    '</section>';
  }).join('');
  return tip + body;
}
function renderSubjectCard(trackId, s){
  const dueClass = (s.info.isDue && !s.info.neverStudied) ? 'is-due' : '';
  const key = trackId+':'+s.id;
  const isConfirming = confirmingDelete === key;
  const statusText = s.info.neverStudied ? '未学習' : (s.info.isDue ? '復習期限超過' : '次回 '+formatDate(s.info.nextReview));
  return '<div class="subject-card '+dueClass+'">' +
    '<div class="subject-card-top"><span class="subject-name">'+escapeHtml(s.name)+'</span>' +
    '<button class="icon-btn" data-action="'+(isConfirming?'confirm-delete-subject':'ask-delete-subject')+'" data-track="'+trackId+'" data-subject="'+s.id+'">'+(isConfirming?'削除？':'✕')+'</button></div>' +
    decaySvg(s) +
    '<div class="subject-meta"><span>理解度 '+Math.round(s.understanding)+'%</span><span>'+statusText+'</span></div>' +
    '<input type="range" min="0" max="100" value="'+Math.round(s.understanding)+'" class="range-input" data-bind="understanding" data-track="'+trackId+'" data-subject="'+s.id+'">' +
    '<button class="btn-small btn-record" data-action="open-rating" data-track="'+trackId+'" data-subject="'+s.id+'">今日学習した内容を記録</button>' +
  '</div>';
}

function renderPlan(){
  const alloc = computeAllocation();
  const allocBar = '<div class="alloc-bar">' + TRACK_ORDER.map(k=>
    '<div class="alloc-seg bar-'+k+'" style="width:'+alloc[k]+'%"></div>'
  ).join('') + '</div>' +
  '<div class="alloc-legend">' + TRACK_ORDER.map(k=>
    '<span><span class="legend-dot bar-'+k+'"></span>'+state.tracks[k].short+' '+Math.round(alloc[k])+'%（1日'+Math.round(state.dailyMinutes*alloc[k]/100)+'分）</span>'
  ).join('') + '</div>';

  const trackSections = TRACK_ORDER.map(k=>{
    const t = state.tracks[k];
    const days = daysUntil(t.examDate);
    if(days <= 30){
      const weights = subjectWeights(t.subjects).slice().sort((a,b)=>b.pct-a.pct);
      const rows = weights.map(s=>
        '<div class="weight-row"><span class="weight-name">'+escapeHtml(s.name)+'</span>' +
        '<div class="weight-bar-track"><div class="weight-bar-fill bar-'+k+'" style="width:'+s.pct+'%"></div></div>' +
        '<span class="weight-pct">'+Math.round(s.pct)+'%</span></div>'
      ).join('') || '<p class="empty-hint">科目未登録</p>';
      return '<section class="section"><h2 class="section-title"><span class="track-chip chip-'+k+'">'+t.short+'</span>'+t.label+'（残り'+days+'日・直前期）</h2>' +
        '<p class="plan-tip">残り期間が短いため、理解度に応じた配分で総復習を進めましょう。最後の数日は暗記事項の見直しに充てるのがおすすめです。</p>' +
        '<div class="weight-list">'+rows+'</div></section>';
    } else {
      const phases = computePhases(t);
      const cards = phases.map(p=>
        '<div class="phase-card"><div class="phase-label">'+p.label+'</div>' +
        '<div class="phase-dates">'+formatDate(p.from)+' 〜 '+formatDate(p.to)+'（'+p.days+'日間）</div>' +
        '<div class="phase-focus">'+p.focus+'</div></div>'
      ).join('');
      return '<section class="section"><h2 class="section-title"><span class="track-chip chip-'+k+'">'+t.short+'</span>'+t.label+'（残り'+days+'日）</h2>' +
        '<div class="phase-list">'+cards+'</div></section>';
    }
  }).join('');

  return '<section class="section"><h2 class="section-title">今後の時間配分（1日 '+state.dailyMinutes+'分）</h2>' + allocBar +
    '<p class="plan-note">配分は各試験までの残り日数から自動計算されています（最低8%は必ず確保）。長期戦の科目も少しずつ触れ続けることで、直前期の負担を減らせます。</p></section>' +
    trackSections;
}

function renderSettings(){
  const rows = TRACK_ORDER.map(k=>{
    const t = state.tracks[k];
    return '<div class="settings-row"><span class="track-chip chip-'+k+'">'+t.short+'</span>' +
      '<label>試験日 <input type="date" class="date-input" data-bind="examDate" data-track="'+k+'" value="'+t.examDate+'"></label>' +
      '<label>目標点数 <input type="number" min="0" max="100" class="number-input" data-bind="targetScore" data-track="'+k+'" value="'+t.targetScore+'">点</label>' +
    '</div>';
  }).join('');
  return '<section class="section"><h2 class="section-title">試験情報</h2>'+rows+'</section>' +
    '<section class="section"><h2 class="section-title">1日の学習可能時間</h2>' +
      '<label>合計 <input type="number" min="0" step="10" class="number-input" data-bind="dailyMinutes" value="'+state.dailyMinutes+'"> 分／日</label>' +
    '</section>' +
    '<section class="section"><h2 class="section-title">データ管理</h2>' +
      '<button class="btn-outline-danger" data-action="'+(confirmingReset?'confirm-reset':'ask-reset')+'">'+(confirmingReset?'本当にすべて削除しますか？（もう一度押すと実行）':'すべてのデータをリセット')+'</button>' +
    '</section>';
}

function renderModal(){
  if(!pendingRating) return '';
  const { trackId, subjectId } = pendingRating;
  const t = state.tracks[trackId];
  const s = t && t.subjects.find(x=>x.id===subjectId);
  if(!s) return '';
  return '<div class="modal-overlay" data-action="close-modal-bg">' +
    '<div class="modal-box">' +
      '<h3>'+escapeHtml(s.name)+'</h3><p class="modal-sub">'+t.short+'・今日の学習を記録します</p>' +
      '<label class="modal-label">理解度（学習後の自己評価）</label>' +
      '<input type="range" min="0" max="100" value="'+Math.round(s.understanding)+'" id="modal-understanding" class="range-input">' +
      '<div class="modal-value"><span id="modal-understanding-value">'+Math.round(s.understanding)+'</span>%</div>' +
      '<label class="modal-label">学習時間（任意・分）</label>' +
      '<input type="number" min="0" step="5" id="modal-minutes" class="number-input" placeholder="例: 30">' +
      '<div class="modal-actions"><button class="btn-outline" data-action="close-modal">キャンセル</button>' +
      '<button class="btn-primary" data-action="save-rating" data-track="'+trackId+'" data-subject="'+subjectId+'">記録する</button></div>' +
    '</div>' +
  '</div>';
}

function render(){
  const app = document.getElementById('app');
  let content = '';
  if(activeTab==='today') content = renderToday();
  else if(activeTab==='karute') content = renderKarute();
  else if(activeTab==='plan') content = renderPlan();
  else content = renderSettings();
  app.innerHTML =
    '<div class="app-shell">' + renderHeader() + '<main id="content">' + content + '</main></div>' +
    renderModal();
}

/* ---------- toast ---------- */
function showToast(msg){
  const c = document.getElementById('toast-container');
  if(!c) return;
  const el = document.createElement('div');
  el.className = 'toast';
  el.textContent = msg;
  c.appendChild(el);
  setTimeout(()=>{ el.classList.add('toast-out'); setTimeout(()=>el.remove(),300); }, 1800);
}

/* ---------- bound field helper ---------- */
function getBoundTarget(t){
  const trackId = t.dataset.track;
  const subjectId = t.dataset.subject;
  if(subjectId){
    const subj = state.tracks[trackId].subjects.find(s=>s.id===subjectId);
    return { obj: subj, key: t.dataset.bind };
  } else if(trackId){
    return { obj: state.tracks[trackId], key: t.dataset.bind };
  }
  return { obj: state, key: t.dataset.bind };
}

/* ---------- events ---------- */
document.addEventListener('click', function(e){
  if(e.target.dataset && e.target.dataset.action === 'close-modal-bg'){
    pendingRating = null; render(); return;
  }
  const btn = e.target.closest('[data-action]');
  if(!btn) return;
  const action = btn.dataset.action;
  if(action === 'close-modal-bg') return;
  switch(action){
    case 'switch-tab':
      activeTab = btn.dataset.tab; confirmingDelete = null; confirmingReset = false; render(); break;
    case 'open-rating':
      pendingRating = { trackId: btn.dataset.track, subjectId: btn.dataset.subject }; render(); break;
    case 'close-modal':
      pendingRating = null; render(); break;
    case 'save-rating': {
      const u = Number(document.getElementById('modal-understanding').value);
      const m = Number(document.getElementById('modal-minutes').value) || 0;
      recordSession(btn.dataset.track, btn.dataset.subject, u, m);
      pendingRating = null;
      showToast('記録しました');
      render();
      break;
    }
    case 'toggle-uncomplete':
      unmarkCompletion(btn.dataset.track, btn.dataset.subject); render(); break;
    case 'ask-delete-subject':
      confirmingDelete = btn.dataset.track+':'+btn.dataset.subject; render(); break;
    case 'confirm-delete-subject':
      deleteSubject(btn.dataset.track, btn.dataset.subject); confirmingDelete = null; render(); break;
    case 'add-subject':
      addSubject(btn.dataset.track); render(); break;
    case 'ask-reset':
      confirmingReset = true; render(); break;
    case 'confirm-reset':
      resetAll(); render(); break;
    case 'add-manual-task':
      addManualTask(); render(); break;
    case 'toggle-manual-task':
      toggleManualTask(btn.dataset.id); render(); break;
    case 'pomodoro-toggle':
      pomodoroStartPause(); render(); break;
    case 'pomodoro-reset':
      pomodoroReset(); render(); break;
  }
});

document.addEventListener('input', function(e){
  const t = e.target;
  if(t.id === 'modal-understanding'){
    const disp = document.getElementById('modal-understanding-value');
    if(disp) disp.textContent = t.value;
    return;
  }
  if(!t.dataset.bind) return;
  const { obj, key } = getBoundTarget(t);
  if(!obj) return;
  let val = t.value;
  if(t.type==='number' || t.type==='range') val = Number(val);
  obj[key] = val;
  saveState();
});

document.addEventListener('change', function(e){
  const t = e.target;
  if(!t.dataset.bind) return;
  saveState();
  render();
});

/* ---------- init ---------- */
loadState();
setInterval(function(){
  const el = document.getElementById('current-clock');
  if(el) el.textContent = currentTimeStr();
  const stEl = document.getElementById('studytime-section');
  if(stEl && activeTab==='today') stEl.innerHTML = studyTimeInnerHtml();
}, 60000);
</script>
</body>
