<body>
<div id="app"><div class="loading-screen">読み込み中…</div></div>
<div id="toast-container"></div>

<script>
const STORAGE_KEY = 'karute-planner-v1';
const TRACK_ORDER = ['teiki','cbt','kokushi'];
const INTERVALS = [1,3,7,14,30];

let state = null;
let activeTab = 'today';
let pendingRating = null;
let confirmingDelete = null;
let confirmingReset = false;
let saveTimer = null;

/* ---------- date utils ---------- */
function todayStr(){
  const t = new Date();
  return t.getFullYear()+'-'+String(t.getMonth()+1).padStart(2,'0')+'-'+String(t.getDate()).padStart(2,'0');
}
function parseLocalDate(s){
  const [y,m,d] = s.split('-').map(Number);
  return new Date(y, m-1, d);
}
function daysBetween(a,b){
  return Math.round((parseLocalDate(b) - parseLocalDate(a)) / 86400000);
}
function daysUntil(dateStr){
  return daysBetween(todayStr(), dateStr);
}
function addDays(dateStr, n){
  const d = parseLocalDate(dateStr);
  d.setDate(d.getDate()+n);
  return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
}
function formatDate(s){
  const [y,m,d] = s.split('-');
  return y+'年'+Number(m)+'月'+Number(d)+'日';
}
function uid(){
  return Math.random().toString(36).slice(2,10) + Date.now().toString(36).slice(-4);
}
function escapeHtml(str){
  return String(str).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

/* ---------- default data ---------- */
function defaultSubjects(base){
  return ['物理系薬学','化学系薬学','生物系薬学','衛生薬学','薬理学','薬剤学','病態・薬物治療','法規・制度・倫理','実務（薬学臨床）']
    .map(name => ({ id: uid(), name, understanding: base, lastStudied: null, reviewStage: 0 }));
}
function seedState(){
  const t = todayStr();
  return {
    version: 1,
    dailyMinutes: 180,
    tracks: {
      teiki:   { label:'定期テスト',        short:'定期', examDate: addDays(t,14),  targetScore:80, subjects: [] },
      cbt:     { label:'CBT',               short:'CBT',  examDate: addDays(t,120), targetScore:70, subjects: defaultSubjects(30) },
      kokushi: { label:'薬剤師国家試験',    short:'国試', examDate:'2029-02-25',    targetScore:65, subjects: defaultSubjects(15) },
    },
    studyLog: [],
    completions: {},
    manualTasks: {},
    streak: { current:0, best:0, lastDate:null },
    timerSessions: [],
    pomodoro: { status:'idle', phase:'work', cycle:1, phaseEndAt:null, remainingWhenPaused:null, todayStartedAt:null },
  };
}
function migrateState(s){
  if(!s.dailyMinutes) s.dailyMinutes = 180;
  if(!s.studyLog) s.studyLog = [];
  if(!s.completions) s.completions = {};
  if(!s.manualTasks) s.manualTasks = {};
  if(!s.streak) s.streak = { current:0, best:0, lastDate:null };
  if(!s.timerSessions) s.timerSessions = [];
  if(!s.pomodoro) s.pomodoro = { status:'idle', phase:'work', cycle:1, phaseEndAt:null, remainingWhenPaused:null, todayStartedAt:null };
  if(!s.tracks) s.tracks = {};
  TRACK_ORDER.forEach(k=>{
    if(!s.tracks[k]) s.tracks[k] = { label:k, short:k, examDate: todayStr(), targetScore:70, subjects: [] };
    if(!s.tracks[k].subjects) s.tracks[k].subjects = [];
    s.tracks[k].subjects.forEach(sub=>{
      if(sub.understanding == null) sub.understanding = 30;
      if(sub.reviewStage == null) sub.reviewStage = 0;
      if(sub.lastStudied === undefined) sub.lastStudied = null;
    });
  });
}

/* ---------- storage ---------- */
async function loadState(){
  try{
    const res = await window.storage.get(STORAGE_KEY, false);
    state = JSON.parse(res.value);
    migrateState(state);
  }catch(e){
    state = seedState();
    try{ await window.storage.set(STORAGE_KEY, JSON.stringify(state), false); }
    catch(e2){ console.error('initial save failed', e2); }
  }
  catchUpPomodoro();
  render();
}
function saveState(){
  clearTimeout(saveTimer);
  saveTimer = setTimeout(async ()=>{
    try{ await window.storage.set(STORAGE_KEY, JSON.stringify(state), false); }
    catch(e){ console.error('save failed', e); showToast('保存に失敗しました'); }
  }, 350);
}

/* ---------- core algorithm ---------- */
function computeAllocation(){
  const raw = {};
  TRACK_ORDER.forEach(k=>{
    const days = Math.max(daysUntil(state.tracks[k].examDate), 1);
    raw[k] = 1/days;
  });
  const sum = Object.values(raw).reduce((a,b)=>a+b,0) || 1;
  let pct = {};
  TRACK_ORDER.forEach(k=> pct[k] = raw[k]/sum*100);
  const FLOOR = 8;
  let deficit = 0, flex = [];
  TRACK_ORDER.forEach(k=>{
    if(pct[k] < FLOOR){ deficit += FLOOR - pct[k]; pct[k] = FLOOR; }
    else flex.push(k);
  });
  if(deficit > 0 && flex.length){
    const flexSum = flex.reduce((a,k)=>a+pct[k],0) || 1;
    flex.forEach(k=> pct[k] -= deficit * (pct[k]/flexSum));
  }
  return pct;
}
function subjectWeights(subjects){
  const weights = subjects.map(s=> Math.max(8, 100 - s.understanding));
  const sum = weights.reduce((a,b)=>a+b,0) || 1;
  return subjects.map((s,i)=> Object.assign({}, s, { pct: weights[i]/sum*100 }));
}
function reviewInfo(subject){
  if(!subject.lastStudied){
    return { level:0, isDue:false, neverStudied:true, nextReview:null, daysSince:null };
  }
  const stage = Math.min(subject.reviewStage||0, INTERVALS.length-1);
  const halfLife = INTERVALS[stage];
  const daysSince = daysBetween(subject.lastStudied, todayStr());
  const level = subject.understanding * Math.exp(-daysSince/halfLife);
  const nextReview = addDays(subject.lastStudied, halfLife);
  const isDue = daysUntil(nextReview) <= 0;
  return { level, isDue, neverStudied:false, nextReview, daysSince };
}
function activityFor(understanding){
  if(understanding < 40) return '教材・講義ノートを読み直して要点を整理する（インプット中心）';
  if(understanding < 70) return '章末問題や過去問を解き、間違えた所だけ解説を確認する';
  return '過去問・模試形式で時間を計って解き、抜けている点だけ最終確認する';
}
function pickFocusSubjects(subjects, minutesBudget){
  if(minutesBudget < 10 || subjects.length === 0) return [];
  const withInfo = subjects.map(s=> Object.assign({}, s, { info: reviewInfo(s) }));
  const due = withInfo.filter(s=> s.info.isDue && !s.info.neverStudied);
  due.sort((a,b)=> daysBetween(b.info.nextReview, todayStr()) - daysBetween(a.info.nextReview, todayStr()));
  const rest = withInfo.filter(s=> !(s.info.isDue && !s.info.neverStudied)).sort((a,b)=> a.understanding - b.understanding);
  const ordered = due.concat(rest);
  const maxPicks = Math.min(4, Math.max(1, Math.floor(minutesBudget/15)));
  const picks = ordered.slice(0, maxPicks);
  const per = Math.max(10, Math.round((minutesBudget/picks.length)/5)*5);
  return picks.map(s=> Object.assign({}, s, { minutes: per, isDue: s.info.isDue && !s.info.neverStudied }));
}
function generateTodayTasks(){
  const alloc = computeAllocation();
  const tasks = [];
  TRACK_ORDER.forEach(k=>{
    const track = state.tracks[k];
    if(!track.subjects.length) return;
    const minutes = state.dailyMinutes * alloc[k] / 100;
    const picks = pickFocusSubjects(track.subjects, minutes);
    picks.forEach(p=>{
      tasks.push({ trackId:k, subjectId:p.id, subjectName:p.name, minutes:p.minutes, activity: activityFor(p.understanding), understanding: p.understanding, isDue: p.isDue });
    });
  });
  return tasks;
}
function computePhases(track){
  const days = Math.max(daysUntil(track.examDate), 1);
  const p1 = Math.max(1, Math.round(days*0.5));
  const p2 = Math.max(1, Math.round(days*0.35));
  const p3 = Math.max(1, days - p1 - p2);
  const start = todayStr();
  const p1end = addDays(start, p1);
