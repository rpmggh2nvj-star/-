/* ---------- svg ---------- */
function decaySvg(subject){
  const W=220,H=60,padL=6,padR=6,padT=8,padB=14;
  const plotW=W-padL-padR, plotH=H-padT-padB;
  if(!subject.lastStudied){
    return '<svg viewBox="0 0 '+W+' '+H+'" class="decay-svg"><text x="'+(W/2)+'" y="'+(H/2)+'" text-anchor="middle" class="decay-empty">未学習</text></svg>';
  }
  const stage = Math.min(subject.reviewStage||0, INTERVALS.length-1);
  const halfLife = INTERVALS[stage];
  const daysSince = daysBetween(subject.lastStudied, todayStr());
  const xMax = Math.max(halfLife*1.5, daysSince+2, 2);
  const steps = 24;
  const pts = [];
  for(let i=0;i<=steps;i++){
    const x = xMax*i/steps;
    const y = subject.understanding * Math.exp(-x/halfLife);
    pts.push([x,y]);
  }
  const xScale = x => padL + (x/xMax)*plotW;
  const yScale = y => padT + (1 - Math.min(y,100)/100) * plotH;
  const pathD = pts.map((p,i)=> (i===0?'M':'L') + xScale(p[0]).toFixed(1) + ',' + yScale(p[1]).toFixed(1)).join(' ');
  const mecY = yScale(50);
  const nowX = xScale(daysSince);
  const nowY = yScale(subject.understanding * Math.exp(-daysSince/halfLife));
  const nextX = xScale(halfLife);
  const isDue = daysSince >= halfLife;
  const curveColor = isDue ? 'var(--red)' : 'var(--green)';
  return '<svg viewBox="0 0 '+W+' '+H+'" class="decay-svg">' +
    '<line x1="'+padL+'" y1="'+mecY.toFixed(1)+'" x2="'+(W-padR)+'" y2="'+mecY.toFixed(1)+'" class="decay-mec"/>' +
    '<line x1="'+nextX.toFixed(1)+'" y1="'+padT+'" x2="'+nextX.toFixed(1)+'" y2="'+(H-padB)+'" class="decay-next"/>' +
    '<path d="'+pathD+'" fill="none" stroke="'+curveColor+'" stroke-width="2"/>' +
    '<circle cx="'+nowX.toFixed(1)+'" cy="'+nowY.toFixed(1)+'" r="3.5" fill="'+curveColor+'"/>' +
    '</svg>';
}

